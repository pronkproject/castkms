config DRM_CASTKMS
	tristate "CastKMS virtual display (Rust, experimental)"
	depends on DRM=y
	depends on RUST
	depends on MMU
	select RUST_DRM_GEM_SHMEM_HELPER
	select DRM_KMS_HELPER
	help
	  Development version of the CastKMS virtual display driver. It provides
	  one to eight virtual outputs and atomic modesetting with software vblank.
	  The in-kernel compositor accepts linear RGB, monochrome and YUV buffers,
	  including CPU-mappable imports, at sizes through 8192x8192. It does not
	  yet provide audio or CEC. Do not use it as a replacement for the C
	  CastKMS driver in a casting session.

	  The module is called castkms.

config DRM_CASTKMS_KUNIT_TEST
	bool "CastKMS scene lifetime tests" if !KUNIT_ALL_TESTS
	depends on DRM_CASTKMS && KUNIT=y
	default KUNIT_ALL_TESTS
	help
	  Test scene replacement, blanking and terminal output shutdown without
	  accessing display pixels. Atomic callback tests use private unregistered
	  devices with synthetic master observations to inspect scene ownership.
	  These tests run when CastKMS is loaded.
